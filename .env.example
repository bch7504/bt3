# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG MẪU / ENVIRONMENT CONFIGURATION TEMPLATE
# Hệ thống Tra cứu & Xử lý vi phạm giao thông (bt3)
# Sao chép file này thành '.env' và cấu hình lại cho phù hợp với môi trường của bạn.
# ==============================================================================

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bt3
DB_USER=your_postgres_user
DB_PASS=your_postgres_password
