# ==============================================================================
# CẤU HÌNH KẾT NỐI DATABASE
# Sao chép file này thành .env rồi thay các giá trị mẫu bằng thông tin thật.
# Không commit file .env vì file đó chứa mật khẩu database.
# ==============================================================================

# Supabase Session Pooler - dùng cho Codespaces và chạy local với Supabase
# Lấy các giá trị tại Supabase Dashboard -> Connect -> Session pooler.
# Dùng cổng 5432; không dùng Transaction pooler cổng 6543.
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASS=your_supabase_database_password
PGSSLMODE=require
